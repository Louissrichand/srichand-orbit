{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  "auth": {
    "rolesSource": "/api/roles",
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/__TENANT_ID__/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        },
        "login": {
          "loginParameters": ["domain_hint=srichand.co.th"]
        }
      }
    }
  },

  "routes": [
    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/.auth/login/google", "statusCode": 404 },
    { "route": "/.auth/login/facebook", "statusCode": 404 },
    { "route": "/.auth/login/apple", "statusCode": 404 },

    { "route": "/api/roles", "allowedRoles": ["anonymous"], "methods": ["POST"] },
    { "route": "/api/admin/*", "allowedRoles": ["orbit-admin"] },
    { "route": "/api/*", "allowedRoles": ["authenticated"] },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],

  "responseOverrides": {
    "401": { "redirect": "/.auth/login/aad", "statusCode": 302 }
  },

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/app/*", "/assets/*", "/db/*", "/docs/*", "*.{png,jpg,svg,ico,css,js,json,md,sql,ps1}"]
  },

  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },

  "platform": { "apiRuntime": "node:20" }
}
